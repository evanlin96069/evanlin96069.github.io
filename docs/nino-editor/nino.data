static const StrIntPair sequence_lookup[] = {
    {"[1~", KEYVAL(KEY_HOME)},
    {"[2~", KEYVAL(KEY_INSERT)},
    {"[3~", KEYVAL(KEY_DELETE)},
    {"[4~", KEYVAL(KEY_END)},
    {"[5~", KEYVAL(KEY_PAGE_UP)},
