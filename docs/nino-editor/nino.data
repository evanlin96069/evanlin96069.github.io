cmake_minimum_required(VERSION 3.15)

project(nino VERSION 0.2.1 LANGUAGES C)

include(GNUInstallDirs)

set(CMAKE_C_STANDARD 11)

set(RESOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/resources")

set (SYNTAX_FILES
    ${RESOURCE_DIR}/syntax/c.json
    ${RESOURCE_DIR}/syntax/cpp.json
    ${RESOURCE_DIR}/syntax/java.json
    ${RESOURCE_DIR}/syntax/json.json
    ${RESOURCE_DIR}/syntax/make.json
    ${RESOURCE_DIR}/syntax/python.json
    ${RESOURCE_DIR}/syntax/rust.json
    ${RESOURCE_DIR}/syntax/zig.json
)

set (BUNDLER_SOURCE "${RESOURCE_DIR}/bundler.c")
set (BUNDLED_FILE "${RESOURCE_DIR}/bundle.h")

if(CMAKE_CROSSCOMPILING)
    # bundle.h must be pre-generated before cross-compiling
    set_source_files_properties(${BUNDLED_FILE} PROPERTIES GENERATED TRUE)
else()
    add_executable(bundler ${BUNDLER_SOURCE})

    set (BUNDLER_BIN $<TARGET_FILE:bundler>)

    add_custom_command(
        OUTPUT ${BUNDLED_FILE}
        COMMAND ${BUNDLER_BIN} ${BUNDLED_FILE} ${SYNTAX_FILES}
        DEPENDS bundler ${SYNTAX_FILES}
        WORKING_DIRECTORY ${CMAKE_CURRENT_LIST_DIR}
    )
endif()

set (CORE_SOURCES
    src/common.h

    src/editor/action.c
    src/editor/action.h
    src/editor/buildnum.c
    src/editor/buildnum.h
    src/editor/config.c
    src/editor/config.h
    src/editor/console.c
    src/editor/console.h
    src/editor/editor.c
    src/editor/editor.h
    src/editor/file_io.c
    src/editor/file_io.h
    src/editor/highlight.c
    src/editor/highlight.h
    src/editor/row.c
    src/editor/row.h
    src/editor/search.c
    src/editor/search.h
    src/editor/select.c
    src/editor/select.h

    src/editor/panels/edit.c
    src/editor/panels/edit.h
    src/editor/panels/explorer.c
    src/editor/panels/explorer.h
    src/editor/panels/prompt.c
    src/editor/panels/prompt.h
    src/editor/panels/welcome.c
    src/editor/panels/welcome.h

    src/ui/compositor.c
    src/ui/compositor.h
    src/ui/layout.c
    src/ui/layout.h
    src/ui/panel.h
    src/ui/rect.h
    src/ui/surface.c
    src/ui/surface.h

    src/utils/json.c
    src/utils/json.h
    src/utils/opt.h
    src/utils/os.h
    src/utils/unicode.c
    src/utils/unicode.h
    src/utils/utils.c
    src/utils/utils.h

    src/backend/platform.h
    src/backend/shared/event.c
    src/backend/shared/event.h
    src/backend/shared/frame_differ.c
    src/backend/shared/frame_differ.h
    src/backend/terminal/main.c
    src/backend/terminal/input.c
    src/backend/terminal/output.c
    src/backend/terminal/terminal.c
    src/backend/terminal/terminal.h
)

if (WIN32)
  list(APPEND CORE_SOURCES
        src/utils/os_win32.c
        src/utils/os_win32.h

        src/backend/terminal/os_win32.c
    )
else()
  list(APPEND CORE_SOURCES
        src/utils/os_unix.c
        src/utils/os_unix.h

        src/backend/terminal/os_unix.c
    )
endif()

add_executable(${PROJECT_NAME} ${CORE_SOURCES} ${BUNDLED_FILE})
target_include_directories(${PROJECT_NAME} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src)

add_custom_target(file_toucher
    COMMAND ${CMAKE_COMMAND} -E touch_nocreate
            ${CMAKE_CURRENT_SOURCE_DIR}/src/editor/buildnum.c
)

add_dependencies(${PROJECT_NAME} file_toucher)

target_compile_definitions(${PROJECT_NAME} PRIVATE
    EDITOR_NAME="${PROJECT_NAME}"
    EDITOR_VERSION="${CMAKE_PROJECT_VERSION}"
)

set(COMMON_HEADER "${CMAKE_SOURCE_DIR}/src/common.h")

if (MSVC)
  target_compile_options(${PROJECT_NAME} PRIVATE /W4 /wd4244 /wd4267 /wd4996 /FI "${COMMON_HEADER}")
else()
  target_compile_options(${PROJECT_NAME} PRIVATE -Wall -Wextra -pedantic -Wshadow -include "${COMMON_HEADER}")
endif()

install(TARGETS ${PROJECT_NAME})
#!/bin/sh
set -eu

if ! command -v clang-format >/dev/null 2>&1; then
    echo "Error: clang-format not found in PATH." >&2
    exit 1
fi

SCRIPT_DIR=$(
    cd "$(dirname "$0")" || exit 1
    pwd -P
)
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
SRC_DIR="$PROJECT_ROOT/src"

find "$SRC_DIR" -type f \( -name "*.c" -o -name "*.h" \) -exec clang-format -i {} +
#!/bin/sh
set -eu

: "${EDITOR_NAME:=nino}"
: "${EDITOR_VERSION:=0.2.1}"
: "${OUTPUT:=$EDITOR_NAME}"
: "${HOST_CC:=cc}"
: "${CC:=cc}"
: "${CFLAGS:=-std=c11 -Wall -Wextra -pedantic -Wshadow}"

# Add command line arguments to CFLAGS
for arg in "$@"; do
    CFLAGS="$CFLAGS $arg"
done

SCRIPT_DIR=$(
    cd "$(dirname "$0")" || exit 1
    pwd -P
)
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
RESOURCE_DIR="$PROJECT_ROOT/resources"
BUILD_DIR="$PROJECT_ROOT/build"

# Add include directories
CFLAGS="$CFLAGS -I$PROJECT_ROOT/src"

mkdir -p "$BUILD_DIR"

printf '%s\n' "[1/3] Building bundler..."
"$HOST_CC" $CFLAGS "$RESOURCE_DIR/bundler.c" -o "$BUILD_DIR/bundler"

printf '%s\n' "[2/3] Generating bundle.h..."
SYNTAX_FILES=""
for f in "$RESOURCE_DIR"/syntax/*.json; do
    [ -f "$f" ] && SYNTAX_FILES="$SYNTAX_FILES $f"
done

if [ -z "$SYNTAX_FILES" ]; then
    printf '%s\n' "Error: no syntax JSON files found in $RESOURCE_DIR/syntax" >&2
    exit 1
fi

"$BUILD_DIR/bundler" "$RESOURCE_DIR/bundle.h" $SYNTAX_FILES

SOURCES="\
    src/editor/action.c
    src/editor/buildnum.c
    src/editor/config.c
    src/editor/console.c
    src/editor/editor.c
    src/editor/file_io.c
    src/editor/highlight.c
    src/editor/row.c
    src/editor/search.c
    src/editor/select.c
    src/editor/panels/edit.c
    src/editor/panels/explorer.c
    src/editor/panels/prompt.c
    src/editor/panels/welcome.c
    src/ui/compositor.c
    src/ui/layout.c
    src/ui/surface.c
    src/utils/json.c
    src/utils/unicode.c
    src/utils/utils.c
    src/backend/shared/event.c
    src/backend/shared/frame_differ.c
    src/backend/terminal/main.c
    src/backend/terminal/input.c
    src/backend/terminal/output.c
    src/backend/terminal/terminal.c
    src/utils/os_unix.c
    src/backend/terminal/os_unix.c"

printf '%s\n' "[3/3] Building $OUTPUT..."
$CC $CFLAGS \
    -include "$PROJECT_ROOT/src/common.h" \
    -DEDITOR_NAME="\"$EDITOR_NAME\"" \
    -DEDITOR_VERSION="\"$EDITOR_VERSION\"" \
    `for s in $SOURCES; do echo "$PROJECT_ROOT/$s"; done` \
    -o "$BUILD_DIR/$OUTPUT"

printf '%s\n' "Done: $BUILD_DIR/$OUTPUT"
#!/bin/sh
set -eu

: "${EDITOR_NAME:=nino}"
: "${EDITOR_VERSION:=0.2.1}"
: "${OUTPUT:=$EDITOR_NAME}"
: "${HOST_CC:=cc}"
: "${EMCC:=emcc}"
: "${CFLAGS:=-std=c11 -Wall -Wextra -pedantic -Wshadow -O2}"

# Usage: build-web.sh [demo_home [demo_workspace]]
# demo_home:      directory bundled as the user home (/home/web_user)
# demo_workspace: path relative to the home that the editor opens
DEMO_HOME=${1:-}
DEMO_WORKSPACE=${2:-}

SCRIPT_DIR=$(
    cd "$(dirname "$0")" || exit 1
    pwd -P
)
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
RESOURCE_DIR="$PROJECT_ROOT/resources"
BUILD_DIR="$PROJECT_ROOT/build"
DIST_DIR="$PROJECT_ROOT/dist/web"

# Add include directories
CFLAGS="$CFLAGS -I$PROJECT_ROOT/src"

mkdir -p "$BUILD_DIR" "$DIST_DIR"

printf '%s\n' "[1/3] Building bundler..."
"$HOST_CC" $CFLAGS "$RESOURCE_DIR/bundler.c" -o "$BUILD_DIR/bundler"

printf '%s\n' "[2/3] Generating bundle.h..."
SYNTAX_FILES=""
for f in "$RESOURCE_DIR"/syntax/*.json; do
    [ -f "$f" ] && SYNTAX_FILES="$SYNTAX_FILES $f"
done

if [ -z "$SYNTAX_FILES" ]; then
    printf '%s\n' "Error: no syntax JSON files found in $RESOURCE_DIR/syntax" >&2
    exit 1
fi

"$BUILD_DIR/bundler" "$RESOURCE_DIR/bundle.h" $SYNTAX_FILES

SOURCES="\
    src/editor/action.c
    src/editor/buildnum.c
    src/editor/config.c
    src/editor/console.c
    src/editor/editor.c
    src/editor/file_io.c
    src/editor/highlight.c
    src/editor/row.c
    src/editor/search.c
    src/editor/select.c
    src/editor/panels/edit.c
    src/editor/panels/explorer.c
    src/editor/panels/prompt.c
    src/editor/panels/welcome.c
    src/ui/compositor.c
    src/ui/layout.c
    src/ui/surface.c
    src/utils/json.c
    src/utils/unicode.c
    src/utils/utils.c
    src/backend/shared/event.c
    src/backend/shared/frame_differ.c
    src/backend/web/web.c
    src/backend/web/input.c
    src/backend/web/output.c
    src/utils/os_unix.c"

WEB_SOURCES="\
    src/backend/web/index.html
    src/backend/web/web.css
    src/backend/web/web.js"

DEMO_FLAGS=""
WEB_HOME="/home/web_user"
if [ -n "$DEMO_HOME" ]; then
    DEMO_FLAGS="--preload-file=$DEMO_HOME@$WEB_HOME"
fi
if [ -n "$DEMO_WORKSPACE" ]; then
    DEMO_FLAGS="$DEMO_FLAGS -DDEMO_WORKSPACE_PATH=\"$WEB_HOME/${DEMO_WORKSPACE#/}\""
fi

printf '%s\n' "[3/3] Building $OUTPUT..."
$EMCC $CFLAGS \
    -include "$PROJECT_ROOT/src/common.h" \
    -DEDITOR_NAME="\"$EDITOR_NAME\"" \
    -DEDITOR_VERSION="\"$EDITOR_VERSION\"" \
    $DEMO_FLAGS \
    $(for s in $SOURCES; do echo "$PROJECT_ROOT/$s"; done) \
    -o "$DIST_DIR/$OUTPUT.js"

printf '%s\n' "[3/3] Copying web files..."
cp $(for s in $WEB_SOURCES; do echo "$PROJECT_ROOT/$s"; done) "$DIST_DIR"

printf '%s\n' "Done: $DIST_DIR/$OUTPUT.wasm"
# Resource files for nino

## syntax
Files in this folder will be bundled in the binary for portability.
If you would like to make your own syntax files,
you can put them in:
- Linux: `~/.config/nino/syntax`
- Windows: `~/.nino/syntax`

## themes
These are some example themes.
You can copy them to the configuration directory like normal configuration files.

Configuration Directory:
- Linux: `~/.config/nino`
- Windows: `~/.nino`

To apply the theme, run it with the `exec` command.
#include <stdio.h>

#define ARGS_SHIFT() \
    {                \
        argc--;      \
        argv++;      \
    }                \
    while (0)

int main(int argc, char* argv[]) {
    if (argc < 3) {
        fprintf(stderr, "Usage: %s <output file> files...\n", argv[0]);
        return 1;
    }

    ARGS_SHIFT();

    FILE* out = fopen(argv[0], "w");
    if (!out) {
        fprintf(stderr, "Failed to open %s to write.\n", argv[1]);
        return 1;
    }

    ARGS_SHIFT();

    fprintf(out, "#ifndef BUNDLE_H\n");
    fprintf(out, "#define BUNDLE_H\n\n");

    for (int i = 0; i < argc; i++) {
        FILE* fp = fopen(argv[i], "r");
        if (!fp) {
            fprintf(stderr, "Failed to open %s to read.\n", argv[i]);
            return 1;
        }

        fprintf(out, "const char bundle%d[] = {", i);

        int index = 0;

        int should_read = 1;
        while (should_read) {
            int byte = fgetc(fp);
            if (byte == EOF) {
                // Makes it null-terminated
                byte = 0;
                should_read = 0;
            }

            if (index % 10 == 0) {
                fprintf(out, "\n    ");
            }
            fprintf(out, "0x%02X, ", byte);
            index++;
        }

        fprintf(out, "\n};\n\n");
        fclose(fp);
    }

    fprintf(out, "const char* bundle[] = {\n");
    for (int i = 0; i < argc; i++) {
        fprintf(out, "    bundle%d,\n", i);
    }
    fprintf(out, "};\n\n");

    fprintf(out, "#endif\n");
    fclose(out);
    return 0;
}
