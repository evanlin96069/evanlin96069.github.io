    FT_INVALID = -1,
    FT_REG,
    FT_DIR,
    FT_NOT_EXIST,
    FT_ACCESS_DENIED,
    FT_NOT_REG,
} FileType;

FileType getFileType(const char* path);

typedef struct DirIter DirIter;
DirIter dirFindFirst(const char* path);
